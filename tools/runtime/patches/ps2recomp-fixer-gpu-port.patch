diff --git a/third_party/src/PS2Recomp/ps2xRuntime/include/kof_pmfhl_compat.h b/third_party/src/PS2Recomp/ps2xRuntime/include/kof_pmfhl_compat.h
new file mode 100644
--- /dev/null
+++ b/third_party/src/PS2Recomp/ps2xRuntime/include/kof_pmfhl_compat.h
@@ -0,0 +1,50 @@
+#pragma once
+// KOF XI spike: PMFHL helpers from the old kof-xi runtime, for generated code made by the old recompiler.
+#include <cstdint>
+#include <emmintrin.h>
+inline uint32_t ps2_pmfhl_word(uint64_t v, int word) { return static_cast<uint32_t>(v >> (word * 32)); }
+inline uint16_t ps2_pmfhl_half(uint64_t v, int half) { return static_cast<uint16_t>(v >> (half * 16)); }
+inline int16_t ps2_pmfhl_sat16(uint32_t w)
+{
+    const int32_t v = static_cast<int32_t>(w);
+    return static_cast<int16_t>(v > 0x7FFF ? 0x7FFF : (v < -0x8000 ? -0x8000 : v));
+}
+inline int64_t ps2_pmfhl_sat32(uint32_t hiWord, uint32_t loWord)
+{
+    const int64_t v = static_cast<int64_t>((static_cast<uint64_t>(hiWord) << 32) | loWord);
+    return v > 0x7FFFFFFFLL ? 0x7FFFFFFFLL : (v < -0x80000000LL ? -0x80000000LL : v);
+}
+inline __m128i ps2_pmfhl_lw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi32(static_cast<int>(ps2_pmfhl_word(hi1, 0)), static_cast<int>(ps2_pmfhl_word(lo1, 0)),
+                         static_cast<int>(ps2_pmfhl_word(hi, 0)), static_cast<int>(ps2_pmfhl_word(lo, 0)));
+}
+inline __m128i ps2_pmfhl_uw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi32(static_cast<int>(ps2_pmfhl_word(hi1, 1)), static_cast<int>(ps2_pmfhl_word(lo1, 1)),
+                         static_cast<int>(ps2_pmfhl_word(hi, 1)), static_cast<int>(ps2_pmfhl_word(lo, 1)));
+}
+inline __m128i ps2_pmfhl_slw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi64x(static_cast<long long>(ps2_pmfhl_sat32(ps2_pmfhl_word(hi1, 0), ps2_pmfhl_word(lo1, 0))),
+                          static_cast<long long>(ps2_pmfhl_sat32(ps2_pmfhl_word(hi, 0), ps2_pmfhl_word(lo, 0))));
+}
+inline __m128i ps2_pmfhl_lh(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi16(static_cast<short>(ps2_pmfhl_half(hi1, 2)), static_cast<short>(ps2_pmfhl_half(hi1, 0)),
+                         static_cast<short>(ps2_pmfhl_half(lo1, 2)), static_cast<short>(ps2_pmfhl_half(lo1, 0)),
+                         static_cast<short>(ps2_pmfhl_half(hi, 2)), static_cast<short>(ps2_pmfhl_half(hi, 0)),
+                         static_cast<short>(ps2_pmfhl_half(lo, 2)), static_cast<short>(ps2_pmfhl_half(lo, 0)));
+}
+inline __m128i ps2_pmfhl_sh(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi16(ps2_pmfhl_sat16(ps2_pmfhl_word(hi1, 1)), ps2_pmfhl_sat16(ps2_pmfhl_word(hi1, 0)),
+                         ps2_pmfhl_sat16(ps2_pmfhl_word(lo1, 1)), ps2_pmfhl_sat16(ps2_pmfhl_word(lo1, 0)),
+                         ps2_pmfhl_sat16(ps2_pmfhl_word(hi, 1)), ps2_pmfhl_sat16(ps2_pmfhl_word(hi, 0)),
+                         ps2_pmfhl_sat16(ps2_pmfhl_word(lo, 1)), ps2_pmfhl_sat16(ps2_pmfhl_word(lo, 0)));
+}
+#define KOF_PMFHL_LW(ctx) ps2_pmfhl_lw((ctx)->hi, (ctx)->lo, (ctx)->hi1, (ctx)->lo1)
+#define KOF_PMFHL_UW(ctx) ps2_pmfhl_uw((ctx)->hi, (ctx)->lo, (ctx)->hi1, (ctx)->lo1)
+#define KOF_PMFHL_SLW(ctx) ps2_pmfhl_slw((ctx)->hi, (ctx)->lo, (ctx)->hi1, (ctx)->lo1)
+#define KOF_PMFHL_LH(ctx) ps2_pmfhl_lh((ctx)->hi, (ctx)->lo, (ctx)->hi1, (ctx)->lo1)
+#define KOF_PMFHL_SH(ctx) ps2_pmfhl_sh((ctx)->hi, (ctx)->lo, (ctx)->hi1, (ctx)->lo1)
