diff --git a/third_party/src/PS2Recomp/ps2xRuntime/src/runner/p2m2_replay.h b/third_party/src/PS2Recomp/ps2xRuntime/src/runner/p2m2_replay.h
new file mode 100644
--- /dev/null
+++ b/third_party/src/PS2Recomp/ps2xRuntime/src/runner/p2m2_replay.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+
+class P2m2Replay
+{
+public:
+    void load(const std::filesystem::path &path)
+    {
+        std::ifstream file(path, std::ios::binary | std::ios::ate);
+        if (!file)
+            throw std::runtime_error("cannot open replay");
+        const auto fileSize = file.tellg();
+        file.seekg(0);
+        std::array<std::uint8_t, 606> header{};
+        if (!file.read(reinterpret_cast<char *>(header.data()), header.size()))
+            throw std::runtime_error("truncated replay header");
+        if (header[0] != 1)
+            throw std::runtime_error("unsupported .p2m2 version");
+        if (header[569] != 0)
+            throw std::runtime_error("savestate-based replays require a PCSX2 savestate; use a power-on recording");
+
+        const std::uint32_t frames = std::uint32_t(header[561]) | (std::uint32_t(header[562]) << 8) |
+                                     (std::uint32_t(header[563]) << 16) | (std::uint32_t(header[564]) << 24);
+        const std::uint64_t bytes = std::uint64_t(frames) * kFrameBytes;
+        if (frames == 0 || bytes > m_payload.max_size() ||
+            fileSize != static_cast<std::streamoff>(header.size() + bytes))
+            throw std::runtime_error("replay length does not match its frame count");
+
+        std::vector<std::uint8_t> payload(static_cast<std::size_t>(bytes));
+        if (!file.read(reinterpret_cast<char *>(payload.data()), static_cast<std::streamsize>(bytes)))
+            throw std::runtime_error("truncated replay payload");
+        m_payload.swap(payload);
+    }
+
+    std::uint64_t frames() const { return m_payload.size() / kFrameBytes; }
+
+    bool sample(std::uint64_t tick, int port, std::uint8_t *state) const
+    {
+        if (tick >= frames() || port < 0 || port > 1)
+            return false;
+        const auto *packet = m_payload.data() + tick * kFrameBytes + port * kPortBytes;
+        // PCSX2 leaves unrecorded controller packets zero-filled.
+        if (std::none_of(packet, packet + kPortBytes, [](std::uint8_t byte) { return byte != 0; }))
+            return false;
+        std::fill_n(state, 32, std::uint8_t{0});
+        state[0] = 0x01;
+        state[1] = 0x79; // DualShock 2 packet with recorded pressures.
+        std::copy_n(packet, kPortBytes, state + 2);
+        return true;
+    }
+
+private:
+    static constexpr std::size_t kPortBytes = 18;
+    static constexpr std::size_t kFrameBytes = 2 * kPortBytes;
+    std::vector<std::uint8_t> m_payload;
+};
